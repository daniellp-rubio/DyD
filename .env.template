
DB_USER=postgres
DB_NAME=DyD
DB_PASSWORD=123456

# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://postgres:123456@localhost:5432/DyD?schema=public"
# Discord Logger
DISCORD_WEBHOOK_URL_INFO=
DISCORD_WEBHOOK_URL_ERRORS=

# Image generation
# "local" = ComfyUI en tu GPU | "together" = Together AI (cloud)
IMAGE_PROVIDER=local

# ComfyUI (solo si IMAGE_PROVIDER=local)
COMFYUI_URL=http://127.0.0.1:8000
# Solo si tus archivos tienen nombres distintos a los defaults:
# COMFYUI_UNET=flux1-dev-fp8.safetensors
# COMFYUI_VAE=ae.safetensors
# COMFYUI_CLIP_T5=t5xxl_fp8_e4m3fn.safetensors
# COMFYUI_CLIP_L=clip_l.safetensors

# Together AI (solo si IMAGE_PROVIDER=together)
TOGETHER_API_KEY=

# Cloudinary upload (para subir imágenes generadas)
CLOUDINARY_LOGO_PUBLIC_ID=Logo_Compacto_con_Fondo_Transparente_DYD_TECH_640x640_pvsf3w

# ── Social publishing ────────────────────────────────────────────────────────
# Instagram Graph API
# 1. Crear Facebook App en developers.facebook.com
# 2. Vincular Instagram Business Account
# 3. Generar Long-Lived Access Token (válido 60 días, renovar con /oauth/access_token)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# TikTok Content Posting API
# 1. Crear app en developers.tiktok.com
# 2. Solicitar permiso "Content Posting" (requiere aprobación manual de TikTok)
# 3. OAuth flow → access_token (válido 24h, usar refresh_token para renovar)
TIKTOK_ACCESS_TOKEN=

