# Cloudinary — mismas credenciales que usa Next.js
CLOUDINARY_CLOUD_NAME=dtttwxbgr
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Modelo (default: CogVideoX-5b-I2V)
# COGVIDEO_MODEL=THUDM/CogVideoX-5b-I2V

# Habilitar CPU offload si hay problemas de VRAM (default: true)
# COGVIDEO_CPU_OFFLOAD=true

# Calidad vs velocidad
# COGVIDEO_STEPS=50
# COGVIDEO_FRAMES=49
# COGVIDEO_FPS=8

# Puerto del servidor (default: 8001)
# PORT=8001
