# ─── DYD — variables de entorno ──────────────────────────────────────────────
# Copia a .env y rellena. Las marcadas (opcional) pueden quedar vacías: la app
# arranca igual; solo se desactiva la feature que dependa de esa key.

# ── Base de datos (requerido) ──
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# ── Auth (requerido) ──
AUTH_SECRET=                      # >= 32 caracteres
AUTH_URL=
NEXT_PUBLIC_APP_URL=

# ── Pagos (requerido en prod) ──
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_WEBHOOK_SECRET=

# ── Anti-bot / email (opcional) ──
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ── Media ──
CLOUDINARY_URL=

# ── Meta Pixel (tracking, ya existente) ──
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# ── Discord (logging + briefing diario) ──
DISCORD_WEBHOOK_URL_INFO=
DISCORD_WEBHOOK_URL_ERRORS=

# ── IA / generación de contenido ──
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
IMAGE_PROVIDER=together          # local | together
COMFYUI_URL=http://127.0.0.1:8188

# ── Cron de contenido ──
CONTENT_CRON_SCHEDULE=0 14 * * *
CONTENT_CRON_ENABLED=false
CONTENT_CRON_SECRET=             # >= 16 chars. En Vercel: pon CRON_SECRET con ESTE mismo valor.

# ── Publicación social (opcional) ──
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
# URL del perfil para el botón "Seguir" del feed de IG en la homepage (opcional)
NEXT_PUBLIC_INSTAGRAM_PROFILE_URL=

# ═══ Roadmap automation (todo opcional — sin estas keys la feature queda inactiva) ═══

# Video: "local" usa el video-server (GPU) existente; "fal" usa fal.ai cloud.
VIDEO_PROVIDER=local
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/wan/v2.2-a14b/image-to-video/turbo

# Memories.ai — análisis de retención de video
MEMORIES_AI_API_KEY=
MEMORIES_AI_BASE_URL=https://api-tools.memories.ai

# Firecrawl — scraping de competencia
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Meta Ads (Marketing API)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=              # act_XXXXXXXXXX
META_FB_PAGE_ID=
META_GRAPH_VERSION=v21.0

# Inteligencia de mercado (opcional)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
